[3.587866, "o", "\u001b[32m✓\u001b[39m found railway.json; it stays as-is\r\n"]
[3.59012, "o", "Found railway.json · 1 service (express-api) · Express · Node >=20 · Postgres referenced via DATABASE_URL\r\n"]
[3.590167, "o", "\r\n"]
[3.590214, "o", "\u001b[32m✓\u001b[39m express-api → serverless ✓ \u001b[2m(Express, entry server.js)\u001b[22m\r\n"]
[3.590265, "o", "\u001b[2m  no longer needed: deploy.numReplicas, deploy.restartPolicyType, deploy.restartPolicyMaxRetries\u001b[22m\r\n"]
[3.59031, "o", "\r\n"]
[3.590423, "o", "\u001b[1mCost estimate\u001b[22m\u001b[2m  (list prices, approximate; printed before anything is created)\u001b[22m\r\n"]
[3.590522, "o", "    item                               idle /mo  ~100k req /mo                                                                                       \r\n"]
[3.590594, "o", "    Lambda Web Function (express-api)  $0        $0.72          \u001b[2mCPU time while code runs + memory per environment-hour; scale to zero\u001b[22m       \r\n    Built-in HTTPS endpoint            $0        $0             \u001b[2mno API Gateway, no load balancer\u001b[22m                                            \r\n"]
[3.590661, "o", "    S3 deploy bucket                   ~$0       ~$0            \u001b[2mlast 10 object versions kept\u001b[22m                                                \r\n    Secrets Manager (1 env)            $0.40     $0.40          \u001b[2mone secret per environment; values baked into the revision, no runtime reads\u001b[22m\r\n    CloudWatch Logs                    $0        $0.05          \u001b[2m14-day retention\u001b[22m                                                            \r\n    IAM, CloudFormation                $0        $0             \u001b[2m\u001b[22m                                                                            \r\n"]
[3.590696, "o", "  Fixed monthly cost: \u001b[1m$0.40\u001b[22m\r\n\r\n"]
